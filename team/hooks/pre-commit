#!/bin/bash
# Pre-commit hook: blocks any modification of organizer files

ORGANIZER_PATTERNS=(
    "^README\.md$"
    "^roadmap\.md$"
    "^INDEX\.md$"
    "^LICENSE.*"
    "^Методички/"
    "^Our try/00-decisions/"
    "^Our try/01-landscape/"
    "^Our try/99-bibliography/"
    "^guide/"
    "^manual/"
)

STAGED_FILES=$(git diff --cached --name-only)

BLOCKED=0
for FILE in $STAGED_FILES; do
    for PATTERN in "${ORGANIZER_PATTERNS[@]}"; do
        if echo "$FILE" | grep -qE "$PATTERN"; then
            echo "❌ [PRE-COMMIT BLOCKED] Спроба змінити файл організаторів: $FILE"
            echo "   Файли організаторів заморожені і не можуть редагуватися."
            echo "   Будь ласка, зберігайте нові матеріали у папці team/ або team/PROPOSED_REGISTER_ENTRIES.md."
            BLOCKED=1
            break
        fi
    done
done

if [ $BLOCKED -ne 0 ]; then
    exit 1
fi
exit 0
