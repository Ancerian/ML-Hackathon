@@ -0,0 +1,77 @@
+"""Green's function of a circular current filament (added 2026-09-29).
+
+Convention: G(Rc, Zc; R, Z) is the poloidal flux PER RADIAN psi [Wb/rad] at (R, Z)
+produced by a 1 A circular filament of radius Rc at height Zc, i.e.
+
+    psi(R, Z) = R * A_phi(R, Z) = M(loop_c, loop_RZ) / (2 pi),
+
+where A_phi is the Biot-Savart vector potential. Because it is a mutual inductance
+divided by 2 pi, G is symmetric in its two points WITHOUT any extra R-weighting:
+G(R, Z; R', Z') == G(R', Z'; R, Z). (The Green's function of the operator Delta*
+itself, G/R, is not symmetric.)
+"""
+import math
+
+import numpy as np
+import pytest
+from scipy import integrate
+
+from src.numerical.compute import MU, GreenFunction, GreenFunctionScaled
+
+# (Rc, Zc, R, Z) : coil position, observation point
+CASES = [
+    (1.5, 0.25, 1.0, 0.0),   # "test loop" from the review : 2.3551e-7 Wb/rad/A
+    (1.0, 0.0, 2.0, 0.0),
+    (1.8, 0.3, 1.7, 0.1),    # close to the filament (k^2 ~ 0.99)
+    (2.2, 0.7, 1.2, -0.4),
+    (0.5, -1.0, 3.0, 2.0),   # far field
+]
+
+
+def psi_biot_savart(Rc, Zc, R, Z, current = 1.0):
+    """psi = R A_phi with A_phi from direct quadrature of the Biot-Savart integral
+    A_phi(R,Z) = mu I Rc / (4 pi) * int_0^{2pi} cos(t) dt / |x - x'(t)|."""
+    def integrand(t):
+        return np.cos(t) / np.sqrt(R * R + Rc * Rc - 2 * R * Rc * np.cos(t) + (Z - Zc) ** 2)
+    val, _ = integrate.quad(integrand, 0.0, 2 * math.pi, epsabs = 0.0, epsrel = 1e-12, limit = 400)
+    return MU * current * Rc / (4 * math.pi) * val * R
+
+
+@pytest.mark.parametrize("Rc, Zc, R, Z", CASES)
+def test_green_matches_biot_savart_quadrature(Rc, Zc, R, Z):
+    ref = psi_biot_savart(Rc, Zc, R, Z)
+    g = GreenFunction(Rc, Zc, R, Z)
+    assert abs(g - ref) / abs(ref) < 1e-6
+    # scaled variant is G / mu
+    assert abs(GreenFunctionScaled(Rc, Zc, R, Z) * MU - ref) / abs(ref) < 1e-6
+
+
+def test_green_reference_value():
+    # value quoted in the review; the old code (ellipk(k) instead of ellipk(k^2)) gave 3.355e-7
+    assert GreenFunction(1.5, 0.25, 1.0, 0.0) == pytest.approx(2.3551e-7, rel = 1e-4)
+
+
+@pytest.mark.parametrize("Rc, Zc, R, Z", CASES)
+def test_green_symmetry(Rc, Zc, R, Z):
+    a = GreenFunction(Rc, Zc, R, Z)
+    b = GreenFunction(R, Z, Rc, Zc)
+    assert abs(a - b) / abs(a) < 1e-12
+
+
+def test_green_vectorised():
+    rng = np.random.default_rng(0)
+    R = rng.uniform(0.5, 3.0, 50)
+    Z = rng.uniform(-1.0, 1.0, 50)
+    g = GreenFunction(1.7, 0.2, R, Z)
+    ref = np.array([psi_biot_savart(1.7, 0.2, r, z) for r, z in zip(R, Z)])
+    assert np.max(np.abs(g - ref) / np.abs(ref)) < 1e-6
+
+
+def test_pinn_green_matches():
+    """src/GSsolver/GradShafranov.py has its own copy (same fix)."""
+    pytest.importorskip("torch")
+    pytest.importorskip("skimage")
+    from src.GSsolver.GradShafranov import compute_Green_function
+    for Rc, Zc, R, Z in CASES:
+        ref = psi_biot_savart(Rc, Zc, R, Z)
+        assert abs(compute_Green_function(Rc, Zc, R, Z) - ref) / abs(ref) < 1e-6
