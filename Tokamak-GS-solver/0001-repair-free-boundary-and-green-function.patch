index 0000000..3bcca74
--- /dev/null
+++ b/tests/test_free_boundary_smoke.py
@@ -0,0 +1,106 @@
+"""Smoke test of the free-boundary solver (added 2026-09-29): a small equilibrium
+must converge and be physically sane."""
+import io
+import contextlib
+
+import numpy as np
+import pytest
+
+from src.numerical.compute import MU
+from src.numerical.grad_shafranov import ElipticOperator, GSsolverFreeBoundary
+
+IP = 2.0e5
+
+
+@pytest.fixture(scope = "module")
+def eq():
+    source = {"PFcoil_current": [-9.0e4, -9.0e4], "rc": [2.2, 2.2], "zc": [0.7, -0.7]}
+    solver = GSsolverFreeBoundary(1.0, 2.0, -0.5, 0.5, m = 1, n = 1, beta_0 = 1.0, lamda_0 = 1.0,
+                                  w = 1.0, source = source, Ip = IP)
+    with contextlib.redirect_stdout(io.StringIO()):
+        solver.solve(Nr = 65, Nz = 65, iteration = 400, convergence = 1e-8)
+    return solver
+
+
+def test_converged(eq):
+    assert eq.converged
+    assert eq.l2_err < 1e-8
+
+
+def test_axis_inside_domain(eq):
+    ia, ja = eq.axis
+    assert 0 < ia < eq.Nr - 1 and 0 < ja < eq.Nz - 1
+    R_ax, Z_ax = eq.RR[eq.axis], eq.ZZ[eq.axis]
+    assert eq.Rl < R_ax < eq.Rr and eq.Zl < Z_ax < eq.Zr
+    assert abs(Z_ax) < 2 * eq.dz            # up-down symmetric coils -> axis near midplane
+    assert eq.mask[eq.axis]                 # axis is inside the plasma
+
+
+def test_psi_n_monotone(eq):
+    ia, ja = eq.axis
+    psi_N = eq.psi_N
+    assert psi_N[ia, ja] == pytest.approx(0.0, abs = 1e-12)
+    # along the four rays from the axis psi_N must increase up to the LCFS (psi_N = 1)
+    for ray in (psi_N[ia:, ja], psi_N[ia::-1, ja], psi_N[ia, ja:], psi_N[ia, ja::-1]):
+        inside = ray[: np.argmax(ray >= 1.0)] if np.any(ray >= 1.0) else ray
+        assert len(inside) > 3
+        assert np.all(np.diff(inside) > 0)
+    assert np.all(psi_N[eq.mask] < 1.0)
+
+
+def test_plasma_mask(eq):
+    assert not eq.mask[eq.edge].any()           # plasma does not touch the box edges
+    assert np.all(eq.J_phi[~eq.mask] == 0.0)    # no current outside the LCFS
+    assert eq.mask.sum() > 100
+
+
+def test_total_current(eq):
+    # (a) integral of J_phi
+    I_J = eq.J_phi.sum() * eq.dr * eq.dz
+    assert abs(I_J - IP) / IP < 1e-2
+    # (b) from the solution: -(1/mu) int Delta* psi / R dA
+    assert abs(eq.total_current() - IP) / IP < 1e-2
+    # (c) independent: Ampere's law, -(1/mu) * loop integral of B_p around the box
+    #     (orientation: (R, phi, Z) right-handed -> counter-clockwise in (R,Z) has normal -phi)
+    dpdR = np.gradient(eq.psi, eq.dr, axis = 0, edge_order = 2)
+    dpdZ = np.gradient(eq.psi, eq.dz, axis = 1, edge_order = 2)
+    BR, BZ = -dpdZ / eq.RR, dpdR / eq.RR
+    R, Z = eq.R1d, eq.Z1d
+    circ = (np.trapezoid(BR[:, 0], R) + np.trapezoid(BZ[-1, :], Z)
+            - np.trapezoid(BR[:, -1], R) - np.trapezoid(BZ[0, :], Z))
+    assert abs(-circ / MU - IP) / IP < 1e-2
+
+
+def test_boundary_psi_from_green_on_all_edges(eq):
+    # the Dirichlet values on every edge equal the Green's-function flux of plasma + coils
+    psi_edge = eq.getJpBoundary(eq.J_phi) + eq.psi_coil.reshape(-1)[eq.edge_idx]
+    np.testing.assert_allclose(eq.psi.reshape(-1)[eq.edge_idx], psi_edge, rtol = 1e-6, atol = 1e-9)
+    # ... and differ between the four edges (not a single averaged constant as before)
+    assert np.ptp(eq.psi[0, :]) > 0 and np.ptp(eq.psi[-1, :]) > 0
+    assert np.ptp(eq.psi[:, 0]) > 0 and np.ptp(eq.psi[:, -1]) > 0
+
+
+@pytest.mark.parametrize("order", ["2nd", "4th"])
+def test_elliptic_operator_polynomial(order):
+    # Delta* psi = psi_RR - psi_R / R + psi_ZZ on polynomials the stencils reproduce exactly:
+    #   2nd order : Delta* (R^2 + Z^3) = (2 - 2) + 6 Z
+    #   4th order : Delta* (R^4 + Z^4) = (12 - 4) R^2 + 12 Z^2
+    Nr, Nz = 21, 17
+    op = ElipticOperator(1.0, 2.0, -0.5, 0.5, Nr, Nz, order = order)
+    R, Z = np.meshgrid(np.linspace(1.0, 2.0, Nr), np.linspace(-0.5, 0.5, Nz), indexing = "ij")
+    if order == "2nd":
+        psi, expected = R ** 2 + Z ** 3, 6 * Z
+    else:
+        psi, expected = R ** 4 + Z ** 4, 8 * R ** 2 + 12 * Z ** 2
+    out = op(psi)
+    inner = (slice(1, -1), slice(1, -1))
+    np.testing.assert_allclose(out[inner], expected[inner], rtol = 1e-8, atol = 1e-7)
+    # boundary rows are identity (Dirichlet)
+    np.testing.assert_allclose(out[0, :], psi[0, :])
+    np.testing.assert_allclose(out[:, -1], psi[:, -1])
+
+
+def test_coil_inside_domain_rejected():
+    with pytest.raises(ValueError):
+        GSsolverFreeBoundary(1.0, 2.0, 0.0, 0.5, 1, 1, 1.0, 1.0,
+                             source = {"PFcoil_current": 1.0, "rc": 1.5, "zc": 0.25})
