index 4527f11..f2a7fff 100644
--- a/src/GSsolver/GradShafranov.py
+++ b/src/GSsolver/GradShafranov.py
@@ -12,6 +12,8 @@ def compute_k(R0 : torch.Tensor, Z0:torch.Tensor, R:torch.Tensor, Z:torch.Tensor
     k = np.clip(k, 1e-10, 1 - 1e-10)
     return k
 
+# NOTE: the two derivative helpers below are d/dk w.r.t. the MODULUS k, i.e. they
+# assume ellipK = K(m = k^2), ellipE = E(m = k^2) (scipy convention). Unused in repo.
 def compute_ellipK_derivative(k, ellipK, ellipE):
     return ellipE / k / (1-k*k) - ellipK / k
 
@@ -19,9 +21,12 @@ def compute_ellipE_derivative(k, ellipK, ellipE):
     return (ellipE - ellipK) / k
 
 def compute_Green_function(R0 : torch.Tensor, Z0:torch.Tensor, R:torch.Tensor, Z:torch.Tensor):
+    # FIX 2026-09-29: scipy.special.ellipk/ellipe expect the parameter m = k^2,
+    # not the modulus k (previously ellipk(k): +9 % near the filament, +42 % at k^2=0.95,
+    # growing without bound for distant points).
     k = compute_k(R0, Z0, R, Z)
-    ellipK = special.ellipk(k)
-    ellipE = special.ellipe(k)
+    ellipK = special.ellipk(k ** 2)
+    ellipE = special.ellipe(k ** 2)
     g = 0.5 / math.pi / k * ((2-k**2) * ellipK - 2 * ellipE) * 4 * math.pi * 10 **(-7)
     g *= np.sqrt(R0 * R)
     return g
